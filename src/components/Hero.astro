---
import { Image } from "astro:assets";
import heroImage from "../assets/images/hero.webp";
---

<section class="hero">
  <Image
    class="hero__image"
    src={heroImage}
    alt=""
    widths={[960, 1440, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="container hero__inner">
    <p class="hero__eyebrow">
      ホームページの費用対効果、見直してみませんか？
    </p>

    <h1 class="hero__title">
      そのホームページ、<br />
      給料分働いていますか？
    </h1>

    <p class="hero__lead">
      サーバー代、保守費、更新費。<br />
      毎月コストがかかるホームページなら、会社の信用・問い合わせ・採用のために
      働いていてほしいと考えます。
    </p>

    <a class="button button--inverse" href="#check">
      今のホームページを確認する
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 92vh;
    place-items: center;
    overflow: hidden;
    color: var(--color-primary-text);
    background: var(--color-primary);
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgb(10 18 32 / 0.48),
        rgb(10 18 32 / 0.78)
      );
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--content-width-lg);
    padding-block: var(--section-space);
    text-align: center;
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-6);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    opacity: 0.82;
  }

  .hero__title {
    margin: 0;
    font-size: var(--font-size-heading-lg);
    font-weight: var(--font-weight-heavy);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    text-wrap: balance;
  }

  .hero__lead {
    max-width: var(--content-width-md);
    margin: var(--space-8) auto 0;
    font-size: var(--font-size-lg);
    text-wrap: balance;
    opacity: 0.88;
  }

  .hero .button {
    margin-top: var(--space-10);
  }

  @media (max-width: 40rem) {
    .hero {
      min-height: 85vh;
    }

    .hero__lead br {
      display: none;
    }
  }
</style>