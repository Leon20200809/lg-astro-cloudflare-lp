---
import { Image } from "astro:assets";
import heroImage from "../assets/images/hero.webp";
---

<section class="hero">
  <Image
    class="hero__image"
    src={heroImage}
    alt=""
    widths={[960, 1440, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="container hero__inner">
    <p class="hero__eyebrow">
      ホームページの費用対効果、見直してみませんか？
    </p>

    <h1 class="hero__title">
      そのホームページ、<br />
      給料分働いていますか？
    </h1>

    <p class="hero__lead">
      サーバー代、保守費、更新費。<br />
      毎月コストがかかるホームページなら、会社の信用・問い合わせ・採用のために
      働いていてほしいと考えます。
    </p>

    <a class="button button--inverse" href="#check">
      今のホームページを確認する
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: min(92vh, 58rem);
    align-items: center;
    overflow: hidden;
    color: var(--color-primary-text);
    background: var(--color-primary);
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(6 16 30 / 0.94) 0%, rgb(6 16 30 / 0.8) 45%, rgb(6 16 30 / 0.25) 100%),
      linear-gradient(180deg, rgb(6 16 30 / 0.15), rgb(6 16 30 / 0.62));
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--container-width);
    padding-block: var(--section-space);
    text-align: left;
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-6);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    color: #b9d8ff;
    opacity: 1;
  }

  .hero__title {
    margin: 0;
    font-size: var(--font-size-heading-lg);
    font-weight: var(--font-weight-heavy);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    max-width: 12ch;
    text-wrap: balance;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.22);
  }

  .hero__lead {
    max-width: 42rem;
    margin: var(--space-8) 0 0;
    font-size: var(--font-size-lg);
    text-wrap: balance;
    line-height: 1.9;
    opacity: 0.9;
  }

  .hero .button {
    margin-top: var(--space-10);
    min-width: 18rem;
    box-shadow: 0 12px 36px rgb(0 0 0 / 0.26);
  }

  @media (max-width: 40rem) {
    .hero {
      min-height: 85vh;
    }

    .hero__lead br {
      display: none;
    }

    .hero__overlay {
      background: linear-gradient(180deg, rgb(6 16 30 / 0.58), rgb(6 16 30 / 0.94));
    }

    .hero__title {
      max-width: 10ch;
    }

    .hero .button {
      width: 100%;
      min-width: 0;
    }
  }
</style>
